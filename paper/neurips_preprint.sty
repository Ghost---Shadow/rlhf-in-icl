% neurips_preprint.sty
% A small, self-contained style that follows the NeurIPS paper layout:
% 5.5in x 9in text block on US letter, Times text, a centred title block
% between two rules, a one-column abstract, and a "Preprint" footer on the
% first page. Written from scratch for this repository (MIT licence); it is
% not the official NeurIPS style file.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_preprint}[2026/11/03 NeurIPS-like preprint layout]

\RequirePackage[letterpaper,textwidth=5.5in,textheight=9in,
  top=1in,headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}

\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}

% Section headings, as in the NeurIPS layout.
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}{1.5ex \@plus 0.3ex}%
  {\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}{0.8ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}{0.5ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}{\normalsize\bfseries}}

% The first-page footer.
\newcommand{\@preprintnote}{Preprint.}
\newcommand{\preprintnote}[1]{\renewcommand{\@preprintnote}{#1}}
\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\small\@preprintnote}%
}
\pagestyle{plain}

% The title block: the title between two rules, then the authors.
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \thispagestyle{firstpage}%
    \vbox{%
      \hsize\textwidth
      \linewidth\hsize
      \vskip 0.1in
      \hrule height 4pt
      \vskip 0.25in
      \centering
      {\LARGE\bfseries \@title\par}
      \vskip 0.29in
      \hrule height 1pt
      \vskip 0.09in
      \def\And{\end{tabular}\hfil\linebreak[0]\hfil
        \begin{tabular}[t]{c}\bfseries\ignorespaces}%
      \begin{tabular}[t]{c}\bfseries\ignorespaces\@author\end{tabular}%
      \vskip 0.3in \@minus 0.1in
    }%
  \endgroup
  \let\maketitle\relax
}

% The abstract: a centred heading and a narrower block.
\renewenvironment{abstract}{%
  \vskip 0.075in
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}{%
  \par
  \end{quote}%
  \vskip 1ex
}

\endinput
